{
  "name": "posecraft",
  "version": "0.1.0",
  "description": "Open 2D character animation runtime, studio and agent authoring tools",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": {
      "types": "./src/schema.d.ts",
      "default": "./src/schema.js"
    },
    "./commands": {
      "types": "./src/commands.d.ts",
      "default": "./src/commands.js"
    },
    "./scene": {
      "types": "./src/scene.d.ts",
      "default": "./src/scene.js"
    },
    "./svg": {
      "types": "./src/svg.d.ts",
      "default": "./src/svg.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./audio": {
      "types": "./src/audio.d.ts",
      "default": "./src/audio.js"
    },
    "./worker": {
      "types": "./src/worker.d.ts",
      "default": "./src/worker.js"
    },
    "./episode": {
      "types": "./src/episode.d.ts",
      "default": "./src/episode.js"
    },
    "./performance": {
      "types": "./src/performance.d.ts",
      "default": "./src/performance.js"
    },
    "./device-motion": {
      "types": "./src/device-motion.d.ts",
      "default": "./src/device-motion.js"
    },
    "./timeline-editing": {
      "types": "./src/timeline-editing.d.ts",
      "default": "./src/timeline-editing.js"
    },
    "./vector-authoring": {
      "types": "./src/vector-authoring.d.ts",
      "default": "./src/vector-authoring.js"
    },
    "./project-bundle": {
      "types": "./src/project-bundle.d.ts",
      "default": "./src/project-bundle.js"
    },
    "./emitters": {
      "types": "./src/emitters.d.ts",
      "default": "./src/emitters.js"
    },
    "./character-rigs": {
      "types": "./src/character-rigs.d.ts",
      "default": "./src/character-rigs.js"
    },
    "./scene-graph": {
      "types": "./src/scene-graph.d.ts",
      "default": "./src/scene-graph.js"
    },
    "./support-balance": {
      "types": "./src/support-balance.d.ts",
      "default": "./src/support-balance.js"
    },
    "./contacts": {
      "types": "./src/contacts.d.ts",
      "default": "./src/contacts.js"
    },
    "./behaviors": {
      "types": "./src/behaviors.d.ts",
      "default": "./src/behaviors.js"
    },
    "./pointer-interactions": {
      "types": "./src/pointer-interactions.d.ts",
      "default": "./src/pointer-interactions.js"
    },
    "./pointer-browser": {
      "types": "./src/pointer-browser.d.ts",
      "default": "./src/pointer-browser.js"
    },
    "./scene-export": {
      "types": "./src/scene-export.d.ts",
      "default": "./src/scene-export.js"
    },
    "./illustration": {
      "types": "./src/illustration.d.ts",
      "default": "./src/illustration.js"
    },
    "./bottle-fluid": {
      "types": "./src/bottle-fluid.d.ts",
      "default": "./src/bottle-fluid.js"
    },
    "./bottle-browser": {
      "types": "./src/bottle-browser.d.ts",
      "default": "./src/bottle-browser.js"
    },
    "./action-variations": {
      "types": "./src/action-variations.d.ts",
      "default": "./src/action-variations.js"
    }
  },
  "bin": {
    "posecraft": "./tools/cli.mjs"
  },
  "files": [
    "src",
    "tools/cli.mjs",
    "examples",
    "skills",
    "docs/api.md",
    "README.md",
    "LICENSE",
    "docs/reactions.md",
    "docs/performance.md",
    "docs/director.md",
    "docs/capture.md",
    "docs/demos.md",
    "docs/spatial.md",
    "docs/skinned-mesh.md",
    "docs/scene-depth.md",
    "docs/lighting.md",
    "docs/timeline.md",
    "docs/draw.md",
    "docs/project-files.md",
    "docs/studio-roadmap.md",
    "docs/emitters.md",
    "docs/contacts.md",
    "tools/build-export-runtimes.mjs",
    "tools/compile-scene.mjs",
    "docs/live-scenes.md",
    "docs/fluids.md",
    "docs/actions.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/build-export-runtimes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "check:package": "npm pack --dry-run",
    "test:types": "tsc --noEmit --strict --module nodenext --target es2022 test/types.ts",
    "test:responses": "node test/responses-browser.mjs",
    "test:performance": "node test/performance-browser.mjs",
    "test:director": "node test/director-browser.mjs",
    "test:capture": "node test/capture-browser.mjs",
    "test:vision": "node test/vision-browser.mjs",
    "test:new-demos": "node test/new-demos-browser.mjs",
    "test:demos": "node test/demos-browser.mjs",
    "test:motion": "node test/motion-browser.mjs",
    "test:spatial": "node test/spatial-browser.mjs",
    "test:lighting": "node test/lighting-browser.mjs",
    "test:lighting-turn": "node test/lighting-turn-browser.mjs",
    "test:campfire-story": "node test/campfire-story-browser.mjs",
    "test:campfire": "node test/campfire-browser.mjs",
    "test:timeline": "node test/timeline-browser.mjs",
    "test:draw": "node test/draw-browser.mjs",
    "test:projects": "node test/project-bundle-browser.mjs",
    "test:workflow": "node test/studio-workflow-browser.mjs",
    "test:emitters": "node test/emitters-browser.mjs",
    "test:scene-tools": "node test/scene-tools-browser.mjs",
    "test:campfire-migration": "node test/campfire-migration-browser.mjs",
    "test:contacts": "node test/contacts-browser.mjs",
    "compile:scene": "node tools/compile-scene.mjs",
    "test:behaviors": "node test/behaviors-browser.mjs",
    "test:live-studio": "node test/live-studio-browser.mjs",
    "test:scene-export": "node test/scene-export-browser.mjs",
    "test:live-pointer": "node test/live-pointer-browser.mjs",
    "test:bottle-fluid": "node test/bottle-fluid-browser.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "planck": "1.4.2"
  }
}
